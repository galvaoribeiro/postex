# =============================================================================
# Motor de Conteudo - variaveis de ambiente
# Copie este arquivo para `.env` e ajuste os valores.
# NUNCA versione o arquivo `.env`.
# =============================================================================

# -----------------------------------------------------------------------------
# Aplicacao
# -----------------------------------------------------------------------------
ENVIRONMENT=development
DEBUG=true
PROJECT_NAME=Motor de Conteudo
API_V1_PREFIX=/api/v1

# Gere um valor forte para producao:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=troque-esta-chave-em-producao-com-no-minimo-32-caracteres

ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# -----------------------------------------------------------------------------
# CORS e cookies
# -----------------------------------------------------------------------------
# Lista separada por virgula das origens do frontend.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Em producao (HTTPS) use COOKIE_SECURE=true.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
# Deixe vazio em desenvolvimento. Em producao com subdominios use ".seudominio.com".
COOKIE_DOMAIN=

# -----------------------------------------------------------------------------
# Banco de dados (Postgres)
# -----------------------------------------------------------------------------
POSTGRES_USER=postex
POSTGRES_PASSWORD=postex
POSTGRES_DB=postex
# Porta publicada no HOST. 5433 evita conflito com uma instalacao local do
# Postgres na 5432. Dentro do compose a porta continua sendo 5432.
POSTGRES_PORT=5433

# Usada pela aplicacao. Dentro do docker compose o host e `postgres:5432`.
# Rodando o backend fora do docker, use `localhost:5433` (ver POSTGRES_PORT).
DATABASE_URL=postgresql+asyncpg://postex:postex@postgres:5432/postex
DATABASE_ECHO=false

# -----------------------------------------------------------------------------
# Redis / fila
# -----------------------------------------------------------------------------
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# `celery` envia as tarefas de IA para o worker; `inline` executa no proprio
# processo da API (util para rodar sem worker e em testes).
AI_EXECUTION_MODE=celery

# -----------------------------------------------------------------------------
# Armazenamento de objetos (MinIO em dev, S3 em producao)
# -----------------------------------------------------------------------------
S3_PORT=9000
S3_CONSOLE_PORT=9001
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=motor-conteudo-assets
S3_REGION=us-east-1

# Endpoint interno usado pelo backend (dentro do compose e `http://minio:9000`).
S3_ENDPOINT_URL=http://minio:9000
# Endpoint que o BROWSER consegue alcancar. As URLs assinadas sao geradas com ele.
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
S3_FORCE_PATH_STYLE=true
S3_PRESIGN_EXPIRE_SECONDS=900

MAX_UPLOAD_SIZE_MB=15
MINIO_CORS_ALLOW_ORIGIN=*

# -----------------------------------------------------------------------------
# Camada de IA
# -----------------------------------------------------------------------------
# `mock`   -> provider local e deterministico, derivado dos dados reais do negocio.
#             Permite usar o produto de ponta a ponta sem nenhuma chave.
# `openai` -> usa a API da OpenAI (exige OPENAI_API_KEY).
AI_PROVIDER=mock

AI_TEMPERATURE=0.8
AI_MAX_RETRIES=3
AI_DEFAULT_IDEA_COUNT=5

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_VISION_MODEL=gpt-4o-mini
# dall-e-3 saiu da API em maio/2026. Padrao atual: gpt-image-2.
# gpt-image-2.5-sunburst e opcional (mais qualidade, mais caro).
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_TIMEOUT_SECONDS=90
# Vazio usa https://api.openai.com/v1. Nao deixe o SDK herdar a string vazia.
OPENAI_BASE_URL=

# Vazio segue AI_PROVIDER. Use `mock` para stills locais mesmo com texto real.
IMAGE_PROVIDER=

# -----------------------------------------------------------------------------
# Frontend (usado pelo Next.js em frontend/.env.local)
# -----------------------------------------------------------------------------
API_PORT=8000
NEXT_PUBLIC_API_URL=http://localhost:8000
